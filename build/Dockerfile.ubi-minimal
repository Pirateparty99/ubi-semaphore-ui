# Runtime stage, appended to upstream's Dockerfile by build-image.sh.
# Rationale for the choices below is in README.md.

FROM registry.access.redhat.com/ubi9/ubi-minimal:${UBI_VERSION}

ARG TARGETARCH=amd64
ARG PYTHON_VERSION=@PYTHON_VERSION@
# renovate: datasource=pypi depName=ansible
ARG ANSIBLE_VERSION=13.5.0
ENV ANSIBLE_VERSION=${ANSIBLE_VERSION}
ARG ANSIBLE_VENV_PATH=/opt/semaphore/apps/ansible/${ANSIBLE_VERSION}/venv
# renovate: datasource=github-releases depName=krallin/tini
ARG TINI_VERSION=v0.19.0

RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 \
        bash git gnupg2 mysql openssh-clients rsync sshpass tar tzdata \
        unzip wget zip jq shadow-utils findutils glibc-langpack-en \
        "python${PYTHON_VERSION}" "python${PYTHON_VERSION}-pip" && \
    microdnf clean all && rm -rf /var/cache/yum /var/cache/dnf && \
    useradd -u 1001 -g 0 -m -d /home/semaphore -s /bin/bash semaphore && \
    mkdir -p /tmp/semaphore /etc/semaphore /var/lib/semaphore /opt/semaphore && \
    chown -R semaphore:0 /tmp/semaphore /etc/semaphore /var/lib/semaphore /opt/semaphore && \
    chmod -R g=u /tmp/semaphore /etc/semaphore /var/lib/semaphore /opt/semaphore && \
    find /usr/lib /usr/lib64 -type d -name __pycache__ -prune -exec rm -rf {} +

# Not packaged for UBI; EPEL-only.
RUN curl -fsSL -o /sbin/tini "https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-static-${TARGETARCH}" && \
    curl -fsSL -o /tmp/tini.sha256sum "https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-static-${TARGETARCH}.sha256sum" && \
    printf '%s  /sbin/tini\n' "$(cut -d' ' -f1 /tmp/tini.sha256sum)" | sha256sum -c - && \
    chmod +x /sbin/tini && rm /tmp/tini.sha256sum

RUN mkdir -p /etc/ssh/ssh_config.d && \
    printf 'Host *\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n' \
      > /etc/ssh/ssh_config.d/semaphore.conf

# Ownership/mode set on COPY, not a later RUN: chmod'ing a copied file rewrites
# it into a second layer, duplicating the binary.
COPY --chown=1001:0 ./deployment/docker/server/ansible.cfg /etc/ansible/ansible.cfg
COPY --from=builder --chown=1001:0 --chmod=755 /go/src/semaphore/deployment/docker/server/server-wrapper /usr/local/bin/
COPY --from=builder --chown=1001:0 --chmod=755 /go/src/semaphore/bin/semaphore /usr/local/bin/
COPY --from=builder /tmp/tofu /usr/local/bin/
COPY --from=builder /tmp/terraform /usr/local/bin/
COPY --from=builder /tmp/terragrunt /usr/local/bin/

WORKDIR /home/semaphore

# No build toolchain: glibc gets prebuilt wheels. See README.md before adding one.
RUN "python${PYTHON_VERSION}" -m venv "${ANSIBLE_VENV_PATH}" --system-site-packages && \
    "${ANSIBLE_VENV_PATH}/bin/pip" install --no-cache-dir --upgrade pip && \
    "${ANSIBLE_VENV_PATH}/bin/pip" install --no-cache-dir \
        "ansible==${ANSIBLE_VERSION}" boto3 botocore requests pywinrm passlib paramiko && \
    find "${ANSIBLE_VENV_PATH}" -type d -name __pycache__ -prune -exec rm -rf {} + && \
    chown -R semaphore:0 /opt/semaphore && \
    chmod -R g=u /opt/semaphore

USER 1001
EXPOSE 3000

ENV VIRTUAL_ENV="${ANSIBLE_VENV_PATH}"
ENV PATH="${ANSIBLE_VENV_PATH}/bin:${PATH}"
ENV LANG=en_US.UTF-8

# Preventing ansible zombie processes. Tini kills zombies.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/usr/local/bin/server-wrapper"]
