# Semaphore UI built on Red Hat UBI instead of Alpine.
#
# This is upstream's deployment/docker/server/Dockerfile expressed in UBI terms.
# It is a file we own rather than a sed-patch of upstream's, because nearly
# every line differs: apk -> dnf/microdnf, adduser -> useradd, and a package set
# that does not map one-for-one. Patching it in place needed a dozen regexes
# against a file upstream rewrites freely; this diffs cleanly instead.
#
# The build context is a semaphore checkout, NOT this repo - upstream's build
# does COPY . /go/src/semaphore. build-image.sh wires that up:
#
#   docker build -f build/Dockerfile.ubi build/semaphore/
#
# BuildKit is required: TARGETOS/TARGETARCH and the cache mounts come from it.

ARG UBI_VERSION=9.8

# ---------------------------------------------------------------------------
# builder
# ---------------------------------------------------------------------------
# go-toolset, not plain ubi + a Go tarball, because it is already a supported
# Go build root. The tag matters more than it looks: semaphore's go.mod requires
# go 1.26.4, and only 9.8 carries a new enough toolchain (1.26.7). The 9.6 and
# 9.7 tags ship 1.24.6 and 1.25.9 and cannot compile this source at all.
FROM registry.access.redhat.com/ubi9/go-toolset:${UBI_VERSION} AS builder

# go-toolset runs as uid 1001 out of /opt/app-root/src. Installing packages and
# writing to /go both need root.
USER 0

ARG NODEJS_VERSION=22

# dnf here, microdnf in the runtime stage: go-toolset is a full UBI image and
# has dnf, while ubi-minimal ships only microdnf. Node is modular in RHEL 9, so
# the stream is enabled explicitly - otherwise the default stream decides the
# frontend's toolchain for us.
RUN dnf -y module enable "nodejs:${NODEJS_VERSION}" && \
    dnf -y install --nodocs --setopt=install_weak_deps=0 \
        nodejs npm git gcc zip unzip tar wget && \
    dnf clean all && rm -rf /var/cache/dnf

# Task runs the build; upstream's installer defaults to ./bin, so send it
# somewhere already on PATH.
RUN curl -fsSL https://taskfile.dev/install.sh | sh -s -- -b /usr/local/bin

# go-toolset puts GOPATH under /opt/app-root, where the golang image upstream
# builds from uses /go. Without this the cache mounts below are mounted at paths
# Go never writes to - they would be silently inert rather than wrong, and every
# build would re-download the module graph.
ENV GOPATH=/go \
    GOCACHE=/root/.cache/go-build \
    HOME=/root
# `task deps:tools` go-installs swagger and friends into $GOPATH/bin; the golang
# image upstream uses has that on PATH already, go-toolset does not.
ENV PATH="/go/bin:${PATH}"

WORKDIR /go/src/semaphore
COPY . /go/src/semaphore

RUN --mount=type=cache,target=/go/pkg \
    go mod download -x

ARG APP_BUILD_TYPE
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG GH_TOKEN
ARG PRO_BRANCH=main

RUN if [ -n "$APP_BUILD_TYPE" ]; then \
      git clone -b "$PRO_BRANCH" "https://${GH_TOKEN}@github.com/semaphoreui/semaphorepro-module.git" pro_impl && \
      go work init . ./pro_impl; \
    fi

RUN --mount=type=cache,target=/go/pkg \
    --mount=type=cache,target=/root/.cache/go-build \
    task deps APP_BUILD_TYPE=${APP_BUILD_TYPE} && \
    task build GOOS=${TARGETOS} GOARCH=${TARGETARCH} APP_BUILD_TYPE=${APP_BUILD_TYPE}

# renovate: datasource=github-releases depName=opentofu/opentofu
ENV OPENTOFU_VERSION=1.11.0
# renovate: datasource=github-releases depName=hashicorp/terraform
ENV TERRAFORM_VERSION=1.11.3
# renovate: datasource=github-releases depName=gruntwork-io/terragrunt
ENV TERRAGRUNT_VERSION=0.78.0
# renovate: datasource=github-releases depName=krallin/tini
ENV TINI_VERSION=v0.19.0

RUN curl -fsSL -O "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" && \
    tar xf "tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" -C /tmp && \
    rm "tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz"

RUN curl -fsSL -O "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip" && \
    unzip "terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip" -d /tmp && \
    rm "terraform_${TERRAFORM_VERSION}_linux_${TARGETARCH}.zip"

RUN curl -fsSL -o /tmp/terragrunt "https://github.com/gruntwork-io/terragrunt/releases/download/v${TERRAGRUNT_VERSION}/terragrunt_linux_${TARGETARCH}" && \
    chmod +x /tmp/terragrunt

# tini is the one package Alpine had that UBI does not - it lives in EPEL, and
# pulling EPEL into a UBI image to get one 24KB init is a bad trade. Fetch the
# static build instead, checksum-verified, the same way the tools above arrive.
RUN curl -fsSL -o /tmp/tini "https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-static-${TARGETARCH}" && \
    curl -fsSL -o /tmp/tini.sha256sum "https://github.com/krallin/tini/releases/download/${TINI_VERSION}/tini-static-${TARGETARCH}.sha256sum" && \
    printf '%s  /tmp/tini\n' "$(cut -d' ' -f1 /tmp/tini.sha256sum)" | sha256sum -c - && \
    chmod +x /tmp/tini && rm /tmp/tini.sha256sum

# ---------------------------------------------------------------------------
# runtime
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-minimal:${UBI_VERSION}

ARG TARGETARCH=amd64
ARG PYTHON_VERSION=3.12
# renovate: datasource=pypi depName=ansible
ARG ANSIBLE_VERSION=13.5.0
ENV ANSIBLE_VERSION=${ANSIBLE_VERSION}
ARG ANSIBLE_VENV_PATH=/opt/semaphore/apps/ansible/${ANSIBLE_VERSION}/venv

# Package name translations from upstream's apk line:
#   py3-pip                -> python${PYTHON_VERSION}-pip
#   openssh-client-default -> openssh-clients
#   mysql-client           -> mysql  (the 8.0 client; server-wrapper shells out
#                                     to `mysql` and `jq` for its backups)
#   gnupg                  -> gnupg2
#   tini                   -> not packaged; copied from the builder below
# curl is deliberately absent: ubi-minimal already ships curl-minimal, and
# asking for curl makes microdnf try to swap it out.
RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 \
        bash git gnupg2 mysql openssh-clients rsync sshpass tar tzdata \
        unzip wget zip jq shadow-utils findutils glibc-langpack-en \
        "python${PYTHON_VERSION}" "python${PYTHON_VERSION}-pip" && \
    microdnf clean all && rm -rf /var/cache/yum /var/cache/dnf

# Upstream's `adduser -D -u 1001 -G root semaphore`. Group 0 rather than a
# private group is deliberate: OpenShift runs the container as an arbitrary uid
# in group 0, so every path below is chowned to :0 and left group-writable.
# The find is rooted at directories that always exist and filtered by -name,
# rather than globbed as /usr/lib/python*; a glob that matches nothing makes
# find exit non-zero, and the usual fix for that - a trailing `|| true` - would
# swallow a failure of every command before it in this chain.
RUN useradd -u 1001 -g 0 -m -d /home/semaphore -s /bin/bash semaphore && \
    mkdir -p /tmp/semaphore /etc/semaphore /var/lib/semaphore /opt/semaphore && \
    chown -R semaphore:0 /tmp/semaphore /etc/semaphore /var/lib/semaphore /opt/semaphore && \
    chmod -R g=u /tmp/semaphore /etc/semaphore /var/lib/semaphore /opt/semaphore && \
    find /usr/lib /usr/lib64 -type d -name __pycache__ -prune -exec rm -rf {} +

# printf rather than upstream's `echo $'...'`: that is a bash ANSI-C quote, and
# RUN uses /bin/sh. It happens to be bash here, but not by contract.
RUN mkdir -p /etc/ssh/ssh_config.d && \
    printf 'Host *\n  StrictHostKeyChecking no\n  UserKnownHostsFile /dev/null\n' \
      > /etc/ssh/ssh_config.d/semaphore.conf

COPY --chown=1001:0 ./deployment/docker/server/ansible.cfg /etc/ansible/ansible.cfg
COPY --from=builder /go/src/semaphore/deployment/docker/server/server-wrapper /usr/local/bin/
COPY --from=builder /go/src/semaphore/bin/semaphore /usr/local/bin/
COPY --from=builder /tmp/tofu /usr/local/bin/
COPY --from=builder /tmp/terraform /usr/local/bin/
COPY --from=builder /tmp/terragrunt /usr/local/bin/
COPY --from=builder /tmp/tini /sbin/tini

RUN chown -R semaphore:0 /usr/local/bin/server-wrapper /usr/local/bin/semaphore && \
    chmod +x /usr/local/bin/server-wrapper /usr/local/bin/semaphore

WORKDIR /home/semaphore

# No compilers here, unlike upstream - and that is a real Alpine/UBI difference,
# not a shortcut. musl cannot use PyPI's manylinux wheels, so on Alpine pip
# builds cryptography, PyNaCl and bcrypt from source and genuinely needs
# gcc/cargo. UBI is glibc: those three all publish manylinux wheels for x86_64
# and aarch64, so pip fetches them prebuilt.
#
# Upstream's install-then-`apk del` dance therefore has nothing to do here, and
# transliterating it does not merely waste a layer - it fails the build. cargo
# pulls in rust, and removing gcc/make strips /usr/bin/cc out from under the
# still-installed rust, so microdnf refuses the whole remove transaction:
#   package rust-1.92.0 from @System requires /usr/bin/cc, but none of the
#   providers can be installed
#
# pip is called by absolute path rather than activating the venv - `source` is
# another bashism, and this avoids needing it.
RUN "python${PYTHON_VERSION}" -m venv "${ANSIBLE_VENV_PATH}" --system-site-packages && \
    "${ANSIBLE_VENV_PATH}/bin/pip" install --no-cache-dir --upgrade pip && \
    "${ANSIBLE_VENV_PATH}/bin/pip" install --no-cache-dir \
        "ansible==${ANSIBLE_VERSION}" boto3 botocore requests pywinrm passlib paramiko && \
    find "${ANSIBLE_VENV_PATH}" -type d -name __pycache__ -prune -exec rm -rf {} + && \
    chown -R semaphore:0 /opt/semaphore && \
    chmod -R g=u /opt/semaphore

USER 1001
EXPOSE 3000

ENV VIRTUAL_ENV="${ANSIBLE_VENV_PATH}"
ENV PATH="${ANSIBLE_VENV_PATH}/bin:${PATH}"
ENV LANG=en_US.UTF-8

# Preventing ansible zombie processes. Tini kills zombies.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/usr/local/bin/server-wrapper"]
